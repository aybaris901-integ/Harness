# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Telegram -----------------------------------------------------------
# From @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (family only).
# Leave empty to allow everyone. Get your ID from @userinfobot.
ALLOWED_USER_IDS=

# --- LLM providers (CLAUDE.md §4) ---------------------------------------
# Primary. https://aistudio.google.com/apikey — free, no card required.
GEMINI_API_KEY=
# Alternatives: gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-3.6-flash
# Set to 0 to disable "thinking" on 2.5-series models (faster, fewer tokens).
# Leave empty for models that do not support the field (e.g. gemini-2.0-flash).
GEMINI_THINKING_BUDGET=0

# Fallback / speed-critical. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional secondary fallback pool. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PAID last resort, same OpenRouter key, billed against your credit balance.
# Only reached when Gemini, Groq and the free pool have all failed; every call
# is logged at WARNING with a "[PAID]" marker. Remove "openrouter-paid" from
# LLM_PROVIDER_CHAIN below to never spend.
OPENROUTER_PAID_MODEL=google/gemini-3.8-flash

# Fallback order. Providers without a key are skipped automatically.
# Keep "openrouter-paid" last — the router warns if a paid tier precedes a free one.
LLM_PROVIDER_CHAIN=gemini,groq,openrouter,openrouter-paid
LLM_REQUEST_TIMEOUT=60

# --- Phase 2: link / video summarizer -----------------------------------
# Scratch space for yt-dlp downloads; each job gets its own subfolder, removed afterwards.
DOWNLOAD_DIR=data/downloads
# Speech-to-text for videos without subtitles. auto = Groq Whisper if
# GROQ_API_KEY is set, otherwise local faster-whisper if `pip install faster-whisper`.
STT_BACKEND=auto
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# faster-whisper model for the local backend: tiny, base, small, medium, large-v3
WHISPER_LOCAL_MODEL=base
# Path to ffmpeg (binary or its folder). Leave empty to use PATH. Without ffmpeg
# audio cannot be compressed/split, so only short videos (< ~25 min) can be transcribed.
FFMPEG_PATH=
# Videos without subtitles longer than this are refused rather than transcribed.
MAX_VIDEO_MINUTES=180

# --- Phase 3: document archive (CLAUDE.md §5) ----------------------------
# REQUIRED. Encrypts document scans + extracted PII at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up somewhere other than the VPS — losing it makes stored documents
# unrecoverable. Never commit it; .env is gitignored.
DOCUMENTS_ENCRYPTION_KEY=
DOCUMENTS_DB_PATH=data/documents.db
DOCUMENTS_SCAN_DIR=data/document_scans
# Path to the tesseract binary (or its folder). Leave empty to use PATH.
TESSERACT_CMD=
# Tesseract language pack(s), e.g. "kaz+rus+eng" once you've installed the
# Kazakh/Russian traineddata. Defaults to "eng", which ships with every
# Tesseract install but will read Cyrillic documents poorly (garbled text,
# document_type stuck at "unknown" for anything without an MRZ to fall back
# on). Set this to "kaz+rus+eng" — see README for installing the packs.
OCR_LANG=eng
# Only needed if kaz.traineddata/rus.traineddata can't be installed into
# Tesseract's own tessdata folder (e.g. no admin rights on Windows, where
# that folder is under Program Files). Points Tesseract at an alternate
# directory containing ALL needed .traineddata files (it replaces the
# search path, not appends to it) — e.g. a folder under your user profile.
# Leave empty to use Tesseract's default tessdata location.
OCR_TESSDATA_DIR=
# Optional local-LLM fallback for field extraction when regex/heuristics find
# nothing (CLAUDE.md §9). Talks to a local Ollama-compatible server directly —
# never llm_router.py, never a cloud call. Off by default.
DOCUMENT_LOCAL_LLM_ENABLED=false
DOCUMENT_LOCAL_LLM_BASE_URL=http://localhost:11434
DOCUMENT_LOCAL_LLM_MODEL=llama3.2

# --- Storage & runtime --------------------------------------------------
DB_PATH=data/harness.db
# How many past turns are replayed to the model on each request.
HISTORY_LIMIT=20
LOG_LEVEL=INFO

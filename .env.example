# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Telegram -----------------------------------------------------------
# From @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (family only).
# Leave empty to allow everyone. Get your ID from @userinfobot.
ALLOWED_USER_IDS=

# --- LLM providers (CLAUDE.md §4) ---------------------------------------
# Primary. https://aistudio.google.com/apikey — free, no card required.
GEMINI_API_KEY=
# Alternatives: gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-3.6-flash
# Set to 0 to disable "thinking" on 2.5-series models (faster, fewer tokens).
# Leave empty for models that do not support the field (e.g. gemini-2.0-flash).
GEMINI_THINKING_BUDGET=0

# Fallback / speed-critical. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional secondary fallback pool. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# PAID last resort, same OpenRouter key, billed against your credit balance.
# Only reached when Gemini, Groq and the free pool have all failed; every call
# is logged at WARNING with a "[PAID]" marker. Remove "openrouter-paid" from
# LLM_PROVIDER_CHAIN below to never spend.
OPENROUTER_PAID_MODEL=google/gemini-3.8-flash

# Fallback order. Providers without a key are skipped automatically.
# Keep "openrouter-paid" last — the router warns if a paid tier precedes a free one.
LLM_PROVIDER_CHAIN=gemini,groq,openrouter,openrouter-paid
LLM_REQUEST_TIMEOUT=60

# --- Phase 2: link / video summarizer -----------------------------------
# Scratch space for yt-dlp downloads; each job gets its own subfolder, removed afterwards.
DOWNLOAD_DIR=data/downloads
# Speech-to-text for videos without subtitles. auto = Groq Whisper if
# GROQ_API_KEY is set, otherwise local faster-whisper if `pip install faster-whisper`.
STT_BACKEND=auto
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# faster-whisper model for the local backend: tiny, base, small, medium, large-v3
WHISPER_LOCAL_MODEL=base
# Path to ffmpeg (binary or its folder). Leave empty to use PATH. Without ffmpeg
# audio cannot be compressed/split, so only short videos (< ~25 min) can be transcribed.
FFMPEG_PATH=
# Videos without subtitles longer than this are refused rather than transcribed.
MAX_VIDEO_MINUTES=180

# --- Storage & runtime --------------------------------------------------
DB_PATH=data/harness.db
# How many past turns are replayed to the model on each request.
HISTORY_LIMIT=20
LOG_LEVEL=INFO
